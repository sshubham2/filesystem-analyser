<Project Sdk="Microsoft.NET.Sdk">

  <!-- The stalled-share rig as a process (SL-038), for the window cases that run the published app against a
       share that stops answering (-IncludeNetwork). Built only by tests/window/WindowCases.ps1 (Update-StallRig)
       into artifacts/stall-rig, and kept out of FsAnalyser.slnx like the hook. The rig itself is the one in
       Core.Tests, compiled here by link, so there is one copy of it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>StallRig</AssemblyName>
    <!-- Self-contained: a machine may have its .NET 10 only in the repo-local .dotnet/ (eng/dotnet.ps1), where a
         framework-dependent exe does not look. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\FsAnalyser.Core.Tests\Rig\SmbRig.cs" Link="Rig\SmbRig.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The versions tests/FsAnalyser.Core.Tests takes too, pinned once in Directory.Build.props (HF-013).
         LGPL-3.0-or-later; tests only, never in the shipped exe. -->
    <PackageReference Include="SMBLibrary" Version="$(FsaSmbLibraryVersion)" />
    <PackageReference Include="SMBLibrary.Win32" Version="$(FsaSmbLibraryWin32Version)" />
  </ItemGroup>

</Project>
