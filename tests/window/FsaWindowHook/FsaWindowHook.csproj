<Project Sdk="Microsoft.NET.Sdk">

  <!-- The window cases' in-process driver (SL-033), loaded into the published app by DOTNET_STARTUP_HOOKS.
       Built only by tests/window/WindowCases.ps1 (Update-Hook) into artifacts/window-hook, and kept out of
       FsAnalyser.slnx so no Core test build compiles WPF test code. It references neither src project: it
       reaches the app through Application.Current and FindName, so the types it sees are the ones bundled in
       the single-file exe. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <AssemblyName>FsaWindowHook</AssemblyName>
  </PropertyGroup>

</Project>
