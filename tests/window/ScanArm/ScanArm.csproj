<Project Sdk="Microsoft.NET.Sdk">

  <!-- SL-095's measurement rig for the pool protocol (tests/window/PoolWatch.ps1), outside FsAnalyser.slnx. Built by
       PoolWatch.ps1 -Prepare through eng/dotnet.ps1 into the gitignored artifacts/scan-arm. It runs the app's own
       Scanner and SizeProbe, which Core makes internal and shows to this assembly by name (InternalsVisibleTo ScanArm
       in FsAnalyser.Core.csproj). The rig and that line are deleted once O-003 is recorded (stack decision). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ScanArm</AssemblyName>
    <RootNamespace>ScanArm</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FsAnalyser.Core\FsAnalyser.Core.csproj" />
  </ItemGroup>

</Project>
