{
  "_note": "The class: how a line of tests/window/PoolWatch.ps1 can compare, match, group or de-duplicate pool tag names without keeping their case (SL-099 review M1, N3). Members come from the people who write PoolWatch's tag lookups, in the spellings the file and PowerShell's own docs use: an operator after a tag (a variable or property named tag, Where-Object's braces and simplified syntax, any -i or no prefix), -contains and -in with a tag on either side, the raw Read-Mark row $_[0], a switch on a tag, the operands the other way round, and Group-Object and -Unique on a tag. fire rows must be matched by at least one pattern of the two fitness entries (PoolWatch never compares pool tag names without regard to case; PoolWatch compares pool tags case-exactly); quiet rows by none: the c-prefixed operators, switch -CaseSensitive, -CaseSensitive, and a comparison with $null. gap rows are what no line pattern sees: they are printed, not failed, and move to fire when a pattern learns them. tests/bugs/SL-099-TagCompareRuleCorpus.Tests.ps1 reads the patterns from .taad/fitness.yaml and this file.",
  "rows": [
    {
      "id": "T01",
      "expect": "fire",
      "line": "@($mark.tags | Where-Object { $_.tag -eq $name })[0]",
      "note": "Tag() with its c dropped: the lookup the NtfF column depends on"
    },
    {
      "id": "T02",
      "expect": "fire",
      "line": "@($mark.tags | Where-Object { $_.tag -ieq $name })[0]",
      "note": "the explicitly case-insensitive operator"
    },
    {
      "id": "T03",
      "expect": "fire",
      "line": "@($mark.tags | Where-Object tag -eq $name)[0]",
      "note": "Where-Object's simplified syntax, no braces and no $_"
    },
    {
      "id": "T04",
      "expect": "fire",
      "line": "$mark.tags | Where-Object -Property tag -EQ -Value $name",
      "note": "the parameter form, operator in capitals"
    },
    {
      "id": "T05",
      "expect": "fire",
      "line": "$mark.tags | Where-Object { $_.tag -like $name }",
      "note": "a wildcard match"
    },
    {
      "id": "T06",
      "expect": "fire",
      "line": "$mark.tags | Where-Object { $_.tag -match \"^$name$\" }",
      "note": "a regex match"
    },
    {
      "id": "T07",
      "expect": "fire",
      "line": "$mark.tags | Where-Object { $_.tag -ne $name }",
      "note": "the negated form"
    },
    {
      "id": "T08",
      "expect": "fire",
      "line": "$mark.tags | Where-Object { $_.tag -notlike 'WC*' }",
      "note": "a negated wildcard (the WC family)"
    },
    {
      "id": "T09",
      "expect": "fire",
      "line": "$mark.tags | Where-Object { $_.tag -in $WatchedTags }",
      "note": "membership, tag on the left"
    },
    {
      "id": "T10",
      "expect": "fire",
      "line": "$mark.tags | Where-Object { $WatchedTags -contains $_.tag }",
      "note": "membership, tag on the right"
    },
    {
      "id": "T11",
      "expect": "fire",
      "line": "$all | Where-Object { $WatchedTags -contains $_[0] }",
      "note": "Read-Mark's filter with its c dropped (review N3)"
    },
    {
      "id": "T12",
      "expect": "fire",
      "line": "$all | Where-Object { $_[0] -eq 'NtfF' }",
      "note": "the raw pool-table row, a literal tag"
    },
    {
      "id": "T13",
      "expect": "fire",
      "line": "$all | Where-Object { $_[0] -in $WatchedTags }",
      "note": "the raw row, membership"
    },
    {
      "id": "T14",
      "expect": "fire",
      "line": "switch ($row.tag) { 'NtfF' { $a = $row } }",
      "note": "switch folds case by default"
    },
    {
      "id": "T15",
      "expect": "fire",
      "line": "switch ($t.tag) {",
      "note": "the same, the block on the next lines"
    },
    {
      "id": "T16",
      "expect": "fire",
      "line": "if ($tag -eq 'NtfF') { $hit = $true }",
      "note": "a variable named tag"
    },
    {
      "id": "T17",
      "expect": "fire",
      "line": "if ($entry.tag -eq 'Ntff') { $hit = $true }",
      "note": "a property named tag, the lower-case variant as the literal"
    },
    {
      "id": "T18",
      "expect": "fire",
      "line": "$known = $NetTags -contains $tag",
      "note": "the named lists on the left"
    },
    {
      "id": "T19",
      "expect": "fire",
      "line": "$known = $NetTags -notcontains $t.tag",
      "note": "the negated membership"
    },
    {
      "id": "T20",
      "expect": "fire",
      "line": "$mark.tags | Where-Object { 'NtfF' -eq $_.tag }",
      "note": "operands the other way round"
    },
    {
      "id": "T21",
      "expect": "fire",
      "line": "$mark.tags | Where-Object { 'NtfF' -ieq $_.tag }",
      "note": "the other way round, explicit -ieq"
    },
    {
      "id": "T22",
      "expect": "fire",
      "line": "$all | Where-Object { 'Ntff' -eq $_[0] }",
