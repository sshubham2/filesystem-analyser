<Project Sdk="Microsoft.NET.Sdk">

  <!-- SL-106's bug reproduction. The trigger is a scan whose guard feeds an error in at one folder's first listing page
       (SynchronousIoCancel.Created and OverrideQueryError, which Core makes internal and shows only to an assembly named
       FsAnalyser.Core.Tests). This project takes that name (and nothing else of it) instead of widening Core's
       InternalsVisibleTo, which would be a change to src, as SL-095's does. It compiles the Core.Tests fixture TempTree (and the
       interop it needs) and the App's pure row words (the unreadable-folders list's and the results list's) as source,
       the way Core.Tests does, so there is no WPF here. Kept out of FsAnalyser.slnx, like the other projects under
       tests/bugs, so no ordinary build compiles it and the two assemblies are never built together. -->
  <PropertyGroup>
    <AssemblyName>FsAnalyser.Core.Tests</AssemblyName>
    <RootNamespace>SL106.OpenedThenFailedKind.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FsAnalyser.Core\FsAnalyser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\FsAnalyser.Core.Tests\TempTree.cs" Link="Linked\TempTree.cs" />
    <Compile Include="..\..\FsAnalyser.Core.Tests\TestNative.cs" Link="Linked\TestNative.cs" />
    <Compile Include="..\..\..\src\FsAnalyser.App\FigureText.cs" Link="Linked\FigureText.cs" />
    <Compile Include="..\..\..\src\FsAnalyser.App\TopLevelRowText.cs" Link="Linked\TopLevelRowText.cs" />
    <Compile Include="..\..\..\src\FsAnalyser.App\UnreadableRows.cs" Link="Linked\UnreadableRows.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
