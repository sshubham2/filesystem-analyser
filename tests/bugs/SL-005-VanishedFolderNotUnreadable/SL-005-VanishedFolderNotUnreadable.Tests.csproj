<Project Sdk="Microsoft.NET.Sdk">

  <!-- SL-005's bug reproduction. The trigger is Scanner.Scan with the scan's AfterFolder seam deleting a folder that is
       still queued on the walk's stack, so it needs ScanOptions and the options overload of Scan, which Core makes internal
       and shows only to an assembly named FsAnalyser.Core.Tests. This project takes that name (and nothing else of it)
       instead of widening Core's InternalsVisibleTo, which would be a change to src. It compiles the Core.Tests fixture
       TempTree (and the interop it needs) as source, the way Core.Tests does. Kept out of FsAnalyser.slnx, like the other
       projects under tests/bugs, so no ordinary build compiles it and the two assemblies are never built together. -->
  <PropertyGroup>
    <AssemblyName>FsAnalyser.Core.Tests</AssemblyName>
    <RootNamespace>SL005.VanishedFolderNotUnreadable.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FsAnalyser.Core\FsAnalyser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\FsAnalyser.Core.Tests\TempTree.cs" Link="Linked\TempTree.cs" />
    <Compile Include="..\..\FsAnalyser.Core.Tests\TestNative.cs" Link="Linked\TestNative.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
