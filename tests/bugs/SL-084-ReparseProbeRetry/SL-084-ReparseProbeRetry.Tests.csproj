<Project Sdk="Microsoft.NET.Sdk">

  <!-- SL-084's bug reproduction. The trigger is the public scan (Scanner.Scan) over a real AF_UNIX socket file, so
       this project references Core alone and reads only its public surface (ScanResult.ProbeFailures, the store's
       flags). Kept out of FsAnalyser.slnx, like the other projects under tests/bugs, so no ordinary build compiles it. -->
  <PropertyGroup>
    <AssemblyName>SL084.ReparseProbeRetry.Tests</AssemblyName>
    <RootNamespace>SL084.ReparseProbeRetry.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FsAnalyser.Core\FsAnalyser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
