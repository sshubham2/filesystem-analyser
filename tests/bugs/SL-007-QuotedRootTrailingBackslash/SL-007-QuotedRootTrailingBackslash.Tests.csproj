<Project Sdk="Microsoft.NET.Sdk">

  <!-- SL-007's bug reproduction: report mode does not see the report option when the root is quoted and ends in a
       backslash (a quoted root ending in a backslash, followed by the report option and its file, reaches the app as
       ONE argument), so the app opens an interactive window on a nonsense root and never exits. The trigger is the
       real command line of the real exe, which Windows splits before any of the app's code runs, so the test starts
       the built FsAnalyser.App.exe as a process and hands it that raw line. Nothing of the App is referenced as code:
       the project reference only makes the build produce the exe (ReferenceOutputAssembly=false), and the exe's folder
       reaches the test as assembly metadata. Kept out of FsAnalyser.slnx, like the other projects under tests/bugs,
       so no ordinary build compiles it. A test project is exempt from the SDK's check that an executable reference
       matches its own self-contained setting, so none is switched off here. NOTE: never write two hyphens in a comment
       of this file, XML forbids it and MSBuild then cannot load the project. -->
  <PropertyGroup>
    <AssemblyName>SL007.QuotedRootTrailingBackslash.Tests</AssemblyName>
    <RootNamespace>SL007.QuotedRootTrailingBackslash.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="FsaAppFolder" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\src\FsAnalyser.App\bin\$(Configuration)\$(TargetFramework)\win-x64'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FsAnalyser.App\FsAnalyser.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
