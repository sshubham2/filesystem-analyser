<Project Sdk="Microsoft.NET.Sdk">

  <!-- SL-063's bug reproduction: TopLevelRowText (FsAnalyser.App) is the real trigger of "the window prints
       no suffix for Done", so this project references the App project directly, the way
       tests/window/FsaWindowHook/FsaWindowHook.csproj does. Kept out of FsAnalyser.slnx for the same reason
       that one is: so no ordinary Core test build compiles WPF test code. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <AssemblyName>SL063.DoneRowFinality.Tests</AssemblyName>
    <RootNamespace>SL063.DoneRowFinality.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FsAnalyser.App\FsAnalyser.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
