<Project Sdk="Microsoft.NET.Sdk">

  <!-- SL-102's bug reproduction. It reads the SOURCES of tests/FsAnalyser.Core.Tests and references nothing of Core, so it
       needs no InternalsVisibleTo and builds alone. Kept out of FsAnalyser.slnx, like the other projects under tests/bugs,
       so no ordinary build compiles it. -->
  <PropertyGroup>
    <RootNamespace>SL102.LastAccessGatesAssertions.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
