<Project Sdk="Microsoft.NET.Sdk">

  <!-- SL-095's bug reproduction. The trigger is Scanner.Scan over the Windows container store, stopped at the scan's
       AfterFolder seam, so it needs ScanOptions and the options overload of Scan, which Core makes internal and
       shows only to an assembly named FsAnalyser.Core.Tests. This project takes that name (and nothing else of it)
       instead of widening Core's InternalsVisibleTo, which would be a change to src. Kept out of FsAnalyser.slnx,
       like the other projects under tests/bugs, so no ordinary build compiles it and the two assemblies are never
       built together. -->
  <PropertyGroup>
    <AssemblyName>FsAnalyser.Core.Tests</AssemblyName>
    <RootNamespace>SL095.ContainerLayerWalk.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FsAnalyser.Core\FsAnalyser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
