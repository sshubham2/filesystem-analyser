<Project Sdk="Microsoft.NET.Sdk">

  <!-- SL-096's bug reproduction. It reads the scan's own LastAccessAsked and LastAccessKept counters, which Core makes
       internal and shows only to an assembly named FsAnalyser.Core.Tests. This project takes that name (and nothing
       else of it) instead of widening Core's InternalsVisibleTo, which would be a change to src. Kept out of
       FsAnalyser.slnx, like the other projects under tests/bugs, so no ordinary build compiles it and the two
       assemblies are never built together. -->
  <PropertyGroup>
    <AssemblyName>FsAnalyser.Core.Tests</AssemblyName>
    <RootNamespace>SL096.LastAccessUnderWindowsTemp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FsAnalyser.Core\FsAnalyser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
