<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The TEST-NET-1 share tests (Trait Network) are opt-in (SL-024, m5): a UNC path by IP address signs
         in with NTLM, and a network that fails fast turns them red. This default filter leaves them out of
         every run that names no filter; an explicit filter replaces it and runs whatever it names. -->
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Network!=TEST-NET-1</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FsAnalyser.Core\FsAnalyser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
