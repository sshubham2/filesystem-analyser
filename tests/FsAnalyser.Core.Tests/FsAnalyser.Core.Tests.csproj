<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The share tests (Trait Network) are opt-in (SL-024). TEST-NET-1 (m5): a UNC path by IP address signs
         in with NTLM, and a network that fails fast turns them red. SMB-LOOPBACK (O-018): a local SMB server
         reached through a New-SmbMapping on another port, which needs the Windows 11 24H2 client. The cloud
         tests (Trait Cloud) are opt-in too (SL-049): CF-SYNC-ROOT registers a real cldflt sync root under
         %TEMP%. This default filter leaves them out of every run that names no filter; an explicit filter
         replaces it and runs whatever it names. -->
    <!-- The default lives in a property of its own (SL-049, M1): a filter named to `dotnet test` sets
         VSTestTestCaseFilter for the whole build, so only this one still holds the default when a filter is named.
         OptInTraitTests reads it from the assembly and fails when a Trait has no Name!=Value clause here. -->
    <FsaDefaultTestFilter>Network!=TEST-NET-1&amp;Network!=SMB-LOOPBACK&amp;Cloud!=CF-SYNC-ROOT</FsaDefaultTestFilter>
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">$(FsaDefaultTestFilter)</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DefaultTestFilter" Value="$(FsaDefaultTestFilter)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The SMB server the stalled-share test runs against (O-018), pinned once in Directory.Build.props with
         tests/window/StallRig, which compiles the same rig (HF-013). LGPL-3.0-or-later; tests only, never
         referenced by Core or the App, so it is not in the shipped exe. -->
    <PackageReference Include="SMBLibrary" Version="$(FsaSmbLibraryVersion)" />
    <PackageReference Include="SMBLibrary.Win32" Version="$(FsaSmbLibraryWin32Version)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FsAnalyser.Core\FsAnalyser.Core.csproj" />
    <!-- The cloud tests' provider (SL-049), built with this project so that CfProvider.dll sits beside the tests,
         which start it through the running runtime's dotnet.exe. No test code uses its types. -->
    <ProjectReference Include="..\CfProvider\CfProvider.csproj" />
    <!-- The held-open rig (SL-056), built with this project for the same reason: HeldOpenTreeTests starts HoldRig.dll
         beside the tests as processes of their own, which hold files open and observe metadata through handles. -->
    <ProjectReference Include="..\HoldRig\HoldRig.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The App's Stopping wording (SL-038), compiled here as source so its boundaries run in the default
         suite. There is no App test project, and this is no reference to the App: the file is pure. -->
    <Compile Include="..\..\src\FsAnalyser.App\StoppingWait.cs" Link="Linked\StoppingWait.cs" />
    <!-- The file kinds list's words (SL-046), pure the same way: its edge cases run beside the breakdown's tests. -->
    <Compile Include="..\..\src\FsAnalyser.App\KindRowText.cs" Link="Linked\KindRowText.cs" />
    <!-- The one percentage formatter the kinds list and the folder tree both write their shares with. -->
    <Compile Include="..\..\src\FsAnalyser.App\ShareText.cs" Link="Linked\ShareText.cs" />
    <!-- The one size and count formatter (HF-012), and the row words that write with it: the folder tree's share and bar,
         and the results list's two lines, without the converter half that binds them (TopLevelRowText.Converter.cs). -->
    <Compile Include="..\..\src\FsAnalyser.App\FigureText.cs" Link="Linked\FigureText.cs" />
    <Compile Include="..\..\src\FsAnalyser.App\FolderTreeRowText.cs" Link="Linked\FolderTreeRowText.cs" />
    <Compile Include="..\..\src\FsAnalyser.App\TopLevelRowText.cs" Link="Linked\TopLevelRowText.cs" />
    <!-- How the window fits itself to its monitor's work area (HF-019), fed here monitors this PC does not have. -->
    <Compile Include="..\..\src\FsAnalyser.App\WorkAreaFit.cs" Link="Linked\WorkAreaFit.cs" />
    <!-- The unreadable-folders list (SL-087): its rows, their order and their reasons, from records a test or a real scan made. -->
    <Compile Include="..\..\src\FsAnalyser.App\UnreadableRows.cs" Link="Linked\UnreadableRows.cs" />
    <!-- How the folder tree learns the kind a failed folder was stamped with (SL-106): no WPF in it, so its lookup, which the
         tree's note reads, runs in the default suite. -->
    <Compile Include="..\..\src\FsAnalyser.App\FolderTreeSession.cs" Link="Linked\FolderTreeSession.cs" />
    <!-- The coverage panel's model and words (SL-001), and the two notes about files whose size was not read: pure, so what the panel
         says of the unseen space, its folders and its remainder runs in the default suite, fed rows a test made. -->
    <Compile Include="..\..\src\FsAnalyser.App\CoveragePanelText.cs" Link="Linked\CoveragePanelText.cs" />
    <!-- How the window cases' hook reads the folder count out of the counters line (SL-044, SL-001): no WPF in it, so that a count of
         one, which the counters write as '1 folder', is read by a test. The hook project compiles the same file. -->
    <Compile Include="..\window\FsaWindowHook\CountersReading.cs" Link="Linked\CountersReading.cs" />
    <!-- Which folder a window case stops the scan at (SL-110, FSA_HOOK_TREE_STOP): the hook's matching words, pure, run here over
         StopTargetCorpus.json. The hook project compiles the same file. -->
    <Compile Include="..\window\FsaWindowHook\StopTarget.cs" Link="Linked\StopTarget.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
