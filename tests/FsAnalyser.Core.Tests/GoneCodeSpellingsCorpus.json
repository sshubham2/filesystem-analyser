{
  "about": "SL-005 review m1 (O-017), closed as a class: the spellings of the gone codes (2, not found; 3, path not found) that a text rule on Scanner.cs or DirectoryReader.cs must catch or let pass. The class is bounded by who produces its members: whoever next writes a gone test in the walk, as the constants, as a comparison of a read error with the literals (the spike's own patch was 'error == 2 || error == 3'), as an 'is' pattern, parenthesised or negated, or on another name for the error. Each row is a line of C# fed to the rule the .taad/fitness.yaml entry holds (found by its name's key phrase), 'fires' says whether that rule must match it. A 'fires: false' row is a line the rule must leave alone: the file's own legitimate uses and prose that names the codes without spelling a comparison. Comments in Scanner.cs name the codes as SizeProbe.IsGone's codes or as 'not found (2) / path not found (3)', never as 'error is N' or 'error == N', because the rule reads comments too.",
  "rules": {
    "walk": "calls a folder gone only through SizeProbe.IsGone",
    "reader": "never turns a gone folder into an empty listing"
  },
  "rows": [
    { "id": "w-const-file", "rule": "walk", "line": "if (error == Kernel32.ERROR_FILE_NOT_FOUND)", "fires": true },
    { "id": "w-const-path", "rule": "walk", "line": "or Kernel32.ERROR_PATH_NOT_FOUND", "fires": true },
    { "id": "w-const-bare", "rule": "walk", "line": "bool gone = code is ERROR_PATH_NOT_FOUND;", "fires": true },
    { "id": "w-literal-eq-or", "rule": "walk", "line": "bool gone = !opened && (error == 2 || error == 3);", "fires": true },
    { "id": "w-literal-eq-3", "rule": "walk", "line": "return error == 3;", "fires": true },
    { "id": "w-literal-no-space", "rule": "walk", "line": "gone = error==2;", "fires": true },
    { "id": "w-literal-is-or", "rule": "walk", "line": "bool gone = !opened && error is 2 or 3;", "fires": true },
    { "id": "w-literal-is-paren", "rule": "walk", "line": "bool gone = !opened && error is (2 or 3);", "fires": true },
    { "id": "w-literal-is-not", "rule": "walk", "line": "bool refused = error is not 2 and not 3;", "fires": true },
    { "id": "w-literal-ne", "rule": "walk", "line": "if (error != 2 && error != 3)", "fires": true },
    { "id": "w-literal-paren-lhs", "rule": "walk", "line": "gone = error == (3);", "fires": true },
    { "id": "w-name-rootError", "rule": "walk", "line": "if (rootError == 3)", "fires": true },
    { "id": "w-name-readError", "rule": "walk", "line": "bool gone = readError is 2 or 3;", "fires": true },
    { "id": "w-name-property", "rule": "walk", "line": "if (reading.Error == 2)", "fires": true },
    { "id": "w-name-win32", "rule": "walk", "line": "if (u.Win32Error == 3)", "fires": true },
    { "id": "w-name-code", "rule": "walk", "line": "return code is 2 or 3;", "fires": true },
    { "id": "w-name-err", "rule": "walk", "line": "if (err == 3)", "fires": true },
    { "id": "w-switch-case-2", "rule": "walk", "line": "case 2:", "fires": true },
    { "id": "w-switch-case-3", "rule": "walk", "line": "    case 3: return true;", "fires": true },
    { "id": "w-through-isgone", "rule": "walk", "line": "internal static bool FolderVanished(int error, bool opened) => !opened && SizeProbe.IsGone(error);", "fires": false },
    { "id": "w-comment-isgone-codes", "rule": "walk", "line": "/// code is one <see cref=\"SizeProbe.IsGone\"/> accepts, the codes the file probe already calls gone.", "fires": false },
    { "id": "w-comment-prose", "rule": "walk", "line": "// not found (2) / path not found (3): the folder is gone", "fires": false },
    { "id": "w-zero", "rule": "walk", "line": "if (error == 0)", "fires": false },
    { "id": "w-nonzero", "rule": "walk", "line": "if (error != 0 && _reader.Count == 0)", "fires": false },
    { "id": "w-named-other", "rule": "walk", "line": "error is Kernel32.ERROR_INVALID_FUNCTION", "fires": false },
    { "id": "w-aborted", "rule": "walk", "line": ": error == Kernel32.ERROR_OPERATION_ABORTED && cancelRequested ? ReadOutcome.Cancelled", "fires": false },
    { "id": "w-twenty-three", "rule": "walk", "line": "if (error == 23)", "fires": false },
    { "id": "w-thirty-two", "rule": "walk", "line": "if (error == 32)", "fires": false },
    { "id": "w-twenty", "rule": "walk", "line": "bool full = error == 20;", "fires": false },
    { "id": "w-count", "rule": "walk", "line": "if (count == 2)", "fires": false },
    { "id": "w-listed", "rule": "walk", "line": "listed > 2 ? UnreadableKind.ListedPartway", "fires": false },
    { "id": "w-denied", "rule": "walk", "line": "if (error == 5)", "fires": false },
    { "id": "w-rootError-call", "rule": "walk", "line": "int rootError = RootOpenError();", "fires": false },
    { "id": "r-isgone-call", "rule": "reader", "line": "if (SizeProbe.IsGone(error)) return 0;", "fires": true },
    { "id": "r-isgone-spaced", "rule": "reader", "line": "if (SizeProbe.IsGone (error)) return 0;", "fires": true },
    { "id": "r-const-path", "rule": "reader", "line": "if (error is Kernel32.ERROR_FILE_NOT_FOUND or Kernel32.ERROR_PATH_NOT_FOUND) return 0;", "fires": true },
    { "id": "r-const-path-bare", "rule": "reader", "line": "return Kernel32.ERROR_PATH_NOT_FOUND;", "fires": true },
    { "id": "r-first-page-not-found", "rule": "reader", "line": "if (first && error == Kernel32.ERROR_FILE_NOT_FOUND)", "fires": false },
    { "id": "r-open-returns-code", "rule": "reader", "line": "if (error != 0) return error;", "fires": false }
  ]
}
