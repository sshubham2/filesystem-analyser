{
  "about": "SL-005 review m1 (O-017), closed as a class: the spellings of the gone codes (2, not found; 3, path not found) that a text rule on Scanner.cs or DirectoryReader.cs must catch or let pass. The class is bounded by who produces its members: whoever next writes a gone test in the walk, as the constants, as a comparison of a read error with the literals (the spike's own patch was 'error == 2 || error == 3'), as an 'is' pattern, parenthesised or negated, or on another name for the error, and, as SL-006 closes (O-018, O-020), as a switch case or a switch-expression arm that spells the codes with C# 9 pattern combinators: 'case 2 or 3:', 'case (2 or 3):', '2 or 3 => ...', '2 => ..., 3 => ...', with another code or a constant beside them in the 'or' chain. Not spelled here, and not caught by a text rule: relational patterns ('>= 2 and <= 3'), a code held in a variable or in hex, and a second predicate that calls the codes by no number at all; FolderVanished's sweep in VanishedFolderCorpusTests is what holds the predicate itself to SizeProbe.IsGone for every code. Each row is a line of C# fed to the rule the .taad/fitness.yaml entry holds (found by its name's key phrase), 'fires' says whether that rule must match it. A 'fires: false' row is a line the rule must leave alone: the file's own legitimate uses and prose that names the codes without spelling a comparison. Comments in Scanner.cs name the codes as SizeProbe.IsGone's codes or as 'not found (2) / path not found (3)', never as 'error is N' or 'error == N', because the rule reads comments too.",
  "rules": {
    "walk": "calls a folder gone only through SizeProbe.IsGone",
    "reader": "never turns a gone folder into an empty listing"
  },
  "rows": [
    { "id": "w-const-file", "rule": "walk", "line": "if (error == Kernel32.ERROR_FILE_NOT_FOUND)", "fires": true },
    { "id": "w-const-path", "rule": "walk", "line": "or Kernel32.ERROR_PATH_NOT_FOUND", "fires": true },
    { "id": "w-const-bare", "rule": "walk", "line": "bool gone = code is ERROR_PATH_NOT_FOUND;", "fires": true },
    { "id": "w-literal-eq-or", "rule": "walk", "line": "bool gone = !opened && (error == 2 || error == 3);", "fires": true },
    { "id": "w-literal-eq-3", "rule": "walk", "line": "return error == 3;", "fires": true },
    { "id": "w-literal-no-space", "rule": "walk", "line": "gone = error==2;", "fires": true },
    { "id": "w-literal-is-or", "rule": "walk", "line": "bool gone = !opened && error is 2 or 3;", "fires": true },
    { "id": "w-literal-is-paren", "rule": "walk", "line": "bool gone = !opened && error is (2 or 3);", "fires": true },
    { "id": "w-literal-is-not", "rule": "walk", "line": "bool refused = error is not 2 and not 3;", "fires": true },
    { "id": "w-literal-ne", "rule": "walk", "line": "if (error != 2 && error != 3)", "fires": true },
    { "id": "w-literal-paren-lhs", "rule": "walk", "line": "gone = error == (3);", "fires": true },
    { "id": "w-name-rootError", "rule": "walk", "line": "if (rootError == 3)", "fires": true },
    { "id": "w-name-readError", "rule": "walk", "line": "bool gone = readError is 2 or 3;", "fires": true },
    { "id": "w-name-property", "rule": "walk", "line": "if (reading.Error == 2)", "fires": true },
    { "id": "w-name-win32", "rule": "walk", "line": "if (u.Win32Error == 3)", "fires": true },
    { "id": "w-name-code", "rule": "walk", "line": "return code is 2 or 3;", "fires": true },
    { "id": "w-name-err", "rule": "walk", "line": "if (err == 3)", "fires": true },
    { "id": "w-switch-case-2", "rule": "walk", "line": "case 2:", "fires": true },
    { "id": "w-switch-case-3", "rule": "walk", "line": "    case 3: return true;", "fires": true },
    { "id": "w-case-or", "rule": "walk", "line": "case 2 or 3:", "fires": true },
    { "id": "w-case-or-reversed", "rule": "walk", "line": "    case 3 or 2: return true;", "fires": true },
    { "id": "w-case-or-three", "rule": "walk", "line": "case 2 or 3 or 5:", "fires": true },
    { "id": "w-case-or-other-first", "rule": "walk", "line": "case 5 or 2 or 3:", "fires": true },
    { "id": "w-case-or-constant-first", "rule": "walk", "line": "case Kernel32.ERROR_ACCESS_DENIED or 3:", "fires": true },
    { "id": "w-case-paren", "rule": "walk", "line": "case (3):", "fires": true },
    { "id": "w-case-paren-or", "rule": "walk", "line": "    case (2 or 3): return true;", "fires": true },
    { "id": "w-case-paren-or-bare", "rule": "walk", "line": "case (2 or 3):", "fires": true },
    { "id": "w-case-paren-or-other-first", "rule": "walk", "line": "case (5 or 3):", "fires": true },
    { "id": "w-case-when", "rule": "walk", "line": "case 2 when !opened:", "fires": true },
    { "id": "w-switch-arm-or", "rule": "walk", "line": "bool gone = !opened && error switch { 2 or 3 => true, _ => false };", "fires": true },
    { "id": "w-switch-arm-or-plain", "rule": "walk", "line": "bool gone = error switch { 2 or 3 => true, _ => false };", "fires": true },
    { "id": "w-switch-arm-or-reversed", "rule": "walk", "line": "bool gone = error switch { 3 or 2 => true, _ => false };", "fires": true },
    { "id": "w-switch-arm-or-three", "rule": "walk", "line": "bool gone = error switch { 2 or 3 or 5 => true, _ => false };", "fires": true },
    { "id": "w-switch-arm-or-other-first", "rule": "walk", "line": "bool gone = error switch { 5 or 2 or 3 => true, _ => false };", "fires": true },
    { "id": "w-switch-arm-or-constant-first", "rule": "walk", "line": "bool gone = error switch { Kernel32.ERROR_ACCESS_DENIED or 3 => true, _ => false };", "fires": true },
    { "id": "w-switch-arm-paren-or", "rule": "walk", "line": "bool gone = error switch { (2 or 3) => true, _ => false };", "fires": true },
    { "id": "w-switch-arm-each", "rule": "walk", "line": "return error switch { 2 => true, 3 => true, _ => false };", "fires": true },
    { "id": "w-switch-arm-lone", "rule": "walk", "line": "return error switch { 3 => true, _ => false };", "fires": true },
    { "id": "w-switch-arm-own-line", "rule": "walk", "line": "        2 or 3 => true,", "fires": true },
    { "id": "w-switch-arm-own-line-each", "rule": "walk", "line": "        3 => UnreadableKind.Gone,", "fires": true },
    { "id": "w-switch-arm-when", "rule": "walk", "line": "        2 when !opened => true,", "fires": true },
    { "id": "w-case-twenty-three", "rule": "walk", "line": "case 23:", "fires": false },
    { "id": "w-case-thirty-two-or-twenty", "rule": "walk", "line": "case 32 or 20:", "fires": false },
    { "id": "w-case-denied", "rule": "walk", "line": "case 5 or 87:", "fires": false },
    { "id": "w-case-paren-denied", "rule": "walk", "line": "case (5 or 87): return true;", "fires": false },
    { "id": "w-case-word", "rule": "walk", "line": "// without case (ContainerLayerStore). A sibling named Layers2, 'Layers.' or 'Layers ' is never equal to it.", "fires": false },
    { "id": "w-switch-arm-denied", "rule": "walk", "line": "bool refused = error switch { 5 or 87 => true, _ => false };", "fires": false },
    { "id": "w-switch-arm-twenty-three", "rule": "walk", "line": "bool full = error switch { 23 => true, _ => false };", "fires": false },
    { "id": "w-switch-arm-thirty-two-or-twenty", "rule": "walk", "line": "        32 or 20 => true,", "fires": false },
    { "id": "w-switch-arm-zero", "rule": "walk", "line": "        0 => ReadOutcome.Listed,", "fires": false },
    { "id": "w-switch-arm-value-two", "rule": "walk", "line": "        ReadOutcome.Failed => 2,", "fires": false },
    { "id": "w-expression-bodied-two", "rule": "walk", "line": "static int Two() => 2;", "fires": false },
    { "id": "w-lambda-adds-two", "rule": "walk", "line": "Func<int, int> next = n => n + 2;", "fires": false },
    { "id": "w-through-isgone", "rule": "walk", "line": "internal static bool FolderVanished(int error, bool opened) => !opened && SizeProbe.IsGone(error);", "fires": false },
    { "id": "w-comment-isgone-codes", "rule": "walk", "line": "/// code is one <see cref=\"SizeProbe.IsGone\"/> accepts, the codes the file probe already calls gone.", "fires": false },
    { "id": "w-comment-prose", "rule": "walk", "line": "// not found (2) / path not found (3): the folder is gone", "fires": false },
    { "id": "w-zero", "rule": "walk", "line": "if (error == 0)", "fires": false },
    { "id": "w-nonzero", "rule": "walk", "line": "if (error != 0 && _reader.Count == 0)", "fires": false },
    { "id": "w-named-other", "rule": "walk", "line": "error is Kernel32.ERROR_INVALID_FUNCTION", "fires": false },
    { "id": "w-aborted", "rule": "walk", "line": ": error == Kernel32.ERROR_OPERATION_ABORTED && cancelRequested ? ReadOutcome.Cancelled", "fires": false },
    { "id": "w-twenty-three", "rule": "walk", "line": "if (error == 23)", "fires": false },
    { "id": "w-thirty-two", "rule": "walk", "line": "if (error == 32)", "fires": false },
    { "id": "w-twenty", "rule": "walk", "line": "bool full = error == 20;", "fires": false },
    { "id": "w-count", "rule": "walk", "line": "if (count == 2)", "fires": false },
    { "id": "w-listed", "rule": "walk", "line": "listed > 2 ? UnreadableKind.ListedPartway", "fires": false },
    { "id": "w-denied", "rule": "walk", "line": "if (error == 5)", "fires": false },
    { "id": "w-rootError-call", "rule": "walk", "line": "int rootError = RootOpenError();", "fires": false },
    { "id": "r-isgone-call", "rule": "reader", "line": "if (SizeProbe.IsGone(error)) return 0;", "fires": true },
    { "id": "r-isgone-spaced", "rule": "reader", "line": "if (SizeProbe.IsGone (error)) return 0;", "fires": true },
    { "id": "r-const-path", "rule": "reader", "line": "if (error is Kernel32.ERROR_FILE_NOT_FOUND or Kernel32.ERROR_PATH_NOT_FOUND) return 0;", "fires": true },
    { "id": "r-const-path-bare", "rule": "reader", "line": "return Kernel32.ERROR_PATH_NOT_FOUND;", "fires": true },
    { "id": "r-first-page-not-found", "rule": "reader", "line": "if (first && error == Kernel32.ERROR_FILE_NOT_FOUND)", "fires": false },
    { "id": "r-open-returns-code", "rule": "reader", "line": "if (error != 0) return error;", "fires": false }
  ]
}
