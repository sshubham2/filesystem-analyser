<Project Sdk="Microsoft.NET.Sdk">

  <!-- SL-056's held-open rig: a process of its own, as a real writer is, that creates a file, grows it and holds it
       open ("hold"), and that reads files' and folders' metadata through handles only, never through a listing
       ("snapshot"). The Core test project references it only so that its build puts HoldRig.dll beside the tests,
       which start it through the running runtime's dotnet.exe, as they start tests/CfProvider. It shares no code
       with what it checks: it is the independent observer of criteria 1, 3, 6 and 7. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

</Project>
