<Window x:Class="FsAnalyser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FsAnalyser.App"
        Title="Filesystem Analyser" Width="880" Height="860" MinWidth="560" MinHeight="644"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.OpenInExplorer}"
                        Executed="OnOpenInExplorer"
                        CanExecute="OnCanOpenInExplorer" />
    </Window.CommandBindings>
    <Window.Resources>
        <ContextMenu x:Key="RowContextMenu" x:Shared="False" Opened="OnRowContextMenuOpened">
            <MenuItem Header="Open in Explorer"
                      InputGestureText="Ctrl+Enter"
                      Command="{x:Static local:MainWindow.OpenInExplorer}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <local:TopLevelRowText x:Key="RowTitle" />
        <local:TopLevelRowText x:Key="RowFigures" Figures="True" />

        <!-- The folder tree's open and close arrow, drawn as the stock one is. -->
        <Style x:Key="FolderTreeExpander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Width="16" Height="16" Background="Transparent" Padding="5,5,5,5">
                            <Path x:Name="Arrow" Data="M0,0 L0,6 L6,0 z" Fill="Transparent" Stroke="#FF818181">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="135" CenterX="3" CenterY="3" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="3" CenterY="3" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Arrow" Property="Fill" Value="#FF595959" />
                                <Setter TargetName="Arrow" Property="Stroke" Value="#FF262626" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Stroke" Value="#FF27C7F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A folder tree row: the stock TreeViewItem's parts, names and triggers, with one change. The stock
             template sizes the header to its content, so columns docked to its right edge would move with every
             name and every depth; here the header runs to the right edge of the tree, which every row at every
             depth shares, so the figures line up under their headings (SL-044). PART_Header and ItemsHost keep
             their names: the TreeView's virtualization reads them. -->
        <ControlTemplate x:Key="FolderTreeItem" TargetType="TreeViewItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="19" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ToggleButton x:Name="Expander" Style="{StaticResource FolderTreeExpander}" ClickMode="Press"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                <Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Border>
                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="False">
                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="Selector.IsSelectionActive" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <DockPanel Margin="16">

        <!-- Pick a drive or folder. As tall however many drives are ready and however narrow the window (SL-040,
             O-028): the drive buttons are one line that scrolls sideways under a scroll bar that is always there,
             disabled while they all fit, so the height left below for the lists never depends on the drives. -->
        <StackPanel x:Name="PickerPanel" DockPanel.Dock="Top">
            <TextBlock Text="Pick a drive or folder to scan" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="DriveStatus" Text="Looking for drives..." Foreground="Gray" Margin="0,0,0,4" />
            <ScrollViewer x:Name="DriveScroller" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel x:Name="DrivePanel" Orientation="Horizontal" />
            </ScrollViewer>
            <!-- The settings, the precautions against defects outside the app (Core's KnownWorkarounds list), share the
                 folder button's line, so the pickers' height is the same with them: the button says how many are off. -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="ChooseFolderButton" Content="Choose a folder..." HorizontalAlignment="Left"
                        Padding="12,6" Click="OnChooseFolder" />
                <Button x:Name="SettingsButton" Content="Settings..." HorizontalAlignment="Left"
                        Padding="12,6" Margin="8,0,0,0" Click="OnSettings"
                        ToolTip="What the app does to avoid defects outside it, in Windows and elsewhere, and the checkbox for each" />
            </StackPanel>
        </StackPanel>

        <!-- A scan in progress -->
        <Border x:Name="ScanningPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,16,0,0"
                Padding="12" BorderBrush="#FFB0C4DE" BorderThickness="1" Background="#FFF4F8FC">
            <StackPanel>
                <TextBlock x:Name="ScanningTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <!-- Shown only while a cancelled scan has not returned after 2 s (StoppingWait) -->
                <TextBlock x:Name="StoppingDetail" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF7A5200" Visibility="Collapsed" />
                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8" />
                <TextBlock x:Name="CountersText" />
                <TextBlock x:Name="CurrentFolderText" Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Left" Padding="12,4"
                        Margin="0,10,0,0" Click="OnCancel" />
            </StackPanel>
        </Border>

        <!-- Reveal status line (SL-047): one bounded line with tooltip so it cannot grow with a path -->
        <TextBlock x:Name="RevealStatus" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                   Foreground="#FF404040" Visibility="Collapsed"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

        <!-- The last child, so it gets the rest of the window's height: how the last scan ended, above what it
             read (SL-040). Every list in it keeps at least one full row in view in every ending, at any size the
             window allows, for any length of text and however many drives are ready (SL-040, O-024 to O-028, the
             window-size rework and SL-065):
             - Text that grows with a path or a count is bounded: while a section of the outcome is shown its texts
               scroll inside a cap of 76 px, a title line and three detail lines, the whole of a finished folder
               scan's; with none shown they take the whole panel, and scroll inside it when they are taller. The
               results header is one line, trimmed; a largest file's location wraps to three lines at most,
               trimmed, with the whole location as its tooltip; the results rows are trimmed, not scrolled
               sideways. What is left varies only with numbers: the largest files' caption, up to three lines at
               the minimum width, and the unreadable folders' count in their tab's header.
             - The reveal status line docked below (SL-047) is one line, trimmed with a tooltip: at most 24 px with
               its 6 px margin when it is shown, and nothing when it is not. The window's minimum height went from 620
               to 644 px to pay for it, so the rows below the pickers keep at least the 396 px they had at 620 with
               the line on screen, and have 24 px more than that without it.
             - Here, a row is star-sized while its panel is shown and takes nothing while it is collapsed, so
               during a scan the results list has all of it. After a stop or a failure the two share it 3 to 1;
               once a scan completes the folder tree is the result a person works down, so it is the other way
               round, 1 to 3 (SL-044, review M2). Neither gets less than its own minimum. The results list's (84)
               is its header and one row, or the header, the tree's headings and one tree row. The outcome's (292)
               is its margin, border and padding (42) and 250 px inside them: the texts' cap (76), the sections'
               margin (10) and OutcomeTabs' MinHeight (154), which is one strip of tab headers (22), the tab's border
               and padding (6), and the largest files' section at its least: a caption of three lines, the column
               headings and one row of the list (126). That is 240, so 10 px are to spare at the smallest size,
               where before SL-065 there were none (the two lists' minimums each had their own row and filled the
               250 to the pixel). Only the selected section is measured, so another section adds nothing to this.
               The pickers above take the same height whatever the window's width and however many drives are
               ready (their drive buttons scroll sideways), so both minimums (376) fit in the 396 px the window's
               minimum size leaves below them at 100% scaling with the status line shown. By default the window is
               860 tall, or the work area's height where that is less, so the tree opens with room for more than a
               few rows (SL-044). B-007, B-008 and S-001 check every list at the minimum size with 26 drive buttons
               added, B-008 with a stopped scan of a long path.
             - The sections are the tabs of OutcomeTabs (SL-065). A section added later (the largest folders, the
               files by extension) is one TabItem there, whose content is its virtualized list or tree itself, or a
               Grid with Auto rows for captions and one star row for the list. It adds no RowDefinition, MinHeight
               or DataTrigger outside its own content, no ScrollViewer, StackPanel or Auto row around its list, and
               its header is about two words (only the unreadable folders' carries a count). Its visibility follows
               its own condition, and EnsureSelectedTabIsVisible is called after that changes. Neither this minimum
               nor the window's changes. It adds report keys for its tab and its list, as LargestFilesTab and
               LargestFilesList have.
             - The headers stay one row at the minimum width (560), which the report's OutcomeTabs.stripRows says;
               a second row would take 22 px from every section, more than the 10 to spare. S-007 checks it with a
               five-digit count of unreadable folders.
             - No list or tree sits in a ScrollViewer, a StackPanel or an Auto row: each of them measures its content
               with an unbounded height, and a list measured so builds a row for every item. The SL-065 spike
               measured a folder of 100,000 rows in a ScrollViewer at 100,001 rows built, 229.7 s to open and about
               2 GB; in a tab, 76 rows of the tree and 37 of a list, 165.6 ms at the most. The architecture rule in
               .taad/fitness.yaml fails a list written straight inside a ScrollViewer here. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=OutcomePanel}" Value="Visible">
                                    <Setter Property="Height" Value="3*" />
                                    <Setter Property="MinHeight" Value="292" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Visibility, ElementName=OutcomePanel}" Value="Visible" />
                                        <Condition Binding="{Binding Visibility, ElementName=FolderTree}" Value="Visible" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Height" Value="1*" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=TopLevelPanel}" Value="Visible">
                                    <Setter Property="Height" Value="1*" />
                                    <Setter Property="MinHeight" Value="84" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Visibility, ElementName=TopLevelPanel}" Value="Visible" />
                                        <Condition Binding="{Binding Visibility, ElementName=FolderTree}" Value="Visible" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Height" Value="3*" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>

            <!-- How the last scan ended: Finished, Stopped, Could not read or Scan failed, and what it found, one
                 section at a time (SL-065). While a section is shown the panel takes its whole row, so the selected
                 section has all of it below the texts, whichever it is; with none shown it is at the top of its row,
                 as tall as its texts and not as its row. -->
            <Border x:Name="OutcomePanel" Grid.Row="0" Visibility="Collapsed" Margin="0,16,0,0" Padding="12" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=OutcomeTabs}" Value="Visible">
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- The texts, then the sections. Every setter below that depends on anything depends on one thing only,
                     whether OutcomeTabs is on screen, which it is while any section is (EnsureSelectedTabIsVisible), and
                     never on how many sections there are or which is selected. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- While a section is shown: the texts' natural height, up to their cap below. With none shown: a
                             star row, so texts taller than the panel scroll inside it, and the panel is as tall as them
                             when they fit. Neither row has a MaxHeight: Grid throws while it arranges (IndexOutOfRange in
                             SetFinalSizeMaxDiscrepancy) when every star row has one and it is given more than they add up
                             to, even by 1e-14 px (measured at SL-040 on the Could not read ending of a relative root). -->
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="*" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=OutcomeTabs}" Value="Visible">
                                            <Setter Property="Height" Value="Auto" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                        <!-- The sections: a star row while they are shown, so the selected one has a bounded height and its
                             list virtualizes; nothing while they are not. -->
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="Auto" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=OutcomeTabs}" Value="Visible">
                                            <Setter Property="Height" Value="*" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                    </Grid.RowDefinitions>

                    <!-- Capped while a section is shown (the fit, above the outer Grid); the rest a scroll away. -->
                    <ScrollViewer x:Name="OutcomeTexts" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=OutcomeTabs}" Value="Visible">
                                        <Setter Property="MaxHeight" Value="76" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel x:Name="OutcomeTextsContent" VerticalAlignment="Top">
                            <TextBlock x:Name="OutcomeTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="OutcomeDetail" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <!-- The whole-drive coverage panel (SL-001): how the space the scan did not see divides by what it knows it
                                 missed. Only for a finished whole-drive scan whose volume figure landed, drawn under the coverage
                                 line, which stays in OutcomeDetail word for word. While a section of the ending is shown these texts are
                                 capped (above), so the panel is a scroll away. -->
                            <StackPanel x:Name="CoveragePanel" Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock x:Name="CoverageLines" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="OutcomeNotes" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF7A5200" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The analysis sections, one tab each, one on screen at a time: the selected one, whose content
                         alone is measured and laid out (the rule for adding one is above the outer Grid). Shown while any
                         section is, and never with a collapsed tab selected (EnsureSelectedTabIsVisible). Its minimum is
                         one strip of headers and the largest files' section with one row of their list. -->
                    <TabControl x:Name="OutcomeTabs" Grid.Row="1" Margin="0,10,0,0" MinHeight="154" Visibility="Collapsed">

                        <!-- The largest single files under the root (SL-040), by space on disk: the caption and the
                             column headings in an Auto row, the list in the star row below. Horizontal scrolling is off so
                             that each location wraps to the row's width instead of running off to the right; three lines
                             at most, so that one row is at most 56 px, as the section's minimum counts it. -->
                        <TabItem x:Name="LargestFilesTab" Header="Largest files" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel x:Name="LargestFilesPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="LargestFilesCaption" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,4" />
                                    <Grid x:Name="LargestFilesHeadings" DockPanel.Dock="Top" Margin="5,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="On disk" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
                                        <TextBlock Grid.Column="1" Text="Size" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
                                        <TextBlock Grid.Column="2" Text="Location" Foreground="Gray" />
                                    </Grid>
                                </DockPanel>
                                <ListBox x:Name="LargestFilesList" Grid.Row="1" Visibility="Collapsed"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding OnDiskText, Mode=OneTime}" TextAlignment="Right" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding SizeText, Mode=OneTime}" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
                                                <TextBlock Grid.Column="2" Text="{Binding Path, Mode=OneTime}" ToolTip="{Binding Path, Mode=OneTime}"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <!-- The folders the scan could not open, and the one it left out on purpose (SL-095, the container layer
                             store): shown when there is at least one of either, never selected by the window itself. Its header
                             counts them ('Unreadable folders (N)', 'Not scanned (N)' when the store is all it holds, or both),
                             set with the list. So its being shown does not say a folder could not be opened: that count is the
                             report's core 'unreadable'. -->
                        <TabItem x:Name="UnreadableTab" Header="Unreadable folders" Visibility="Collapsed">
                            <ListBox x:Name="UnreadableList"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- What has been read under the root, largest first: filled in while the scan runs and kept after a
                 stop (SL-039); once a scan completes, the folder tree takes its place in the same cell (SL-044).
                 Its row gives the list and the tree a bounded height, all that is left while the scan runs and its
                 share beside the outcome after it, which is what lets them virtualize: only the rows on screen get
                 containers. Two TextBlocks a list row, as measured, and one line a tree row, trimmed rather than
                 scrolled sideways, and a header of one line with the whole of it as its tooltip, so the row's
                 minimum (84) holds for any name: the header and one list row, or the header, the tree's headings and
                 one tree row. -->
            <DockPanel x:Name="TopLevelPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,16,0,0">
                <!-- The header, one line, and at its right the choice between the folders and the files by kind (SL-046),
                     on the same line, so the choice takes no height: every minimum above holds as measured. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel x:Name="ViewPicker" DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <RadioButton x:Name="ShowFoldersButton" Content="Folders" GroupName="ResultsView" IsChecked="True" />
                        <!-- Only at a stopped ending that offers it (SL-110, Q-273): the stopped list stays the view the ending
                             opens on, and this brings in the folder tree over what the scan read, with the folders it never
                             reached marked as unread (the word is TopLevelRowText.NotReadYet's, written nowhere else). -->
                        <RadioButton x:Name="ShowTreeButton" Content="Folder tree" GroupName="ResultsView" Margin="12,0,0,0"
                                     Visibility="Collapsed" Checked="OnResultsViewChanged" Unchecked="OnResultsViewChanged"
                                     ToolTip="The folders the scan read, largest first, as a tree, with the folders the stop came before marked" />
                        <RadioButton x:Name="ShowKindsButton" Content="File kinds" GroupName="ResultsView" Margin="12,0,0,0"
                                     Checked="OnResultsViewChanged" Unchecked="OnResultsViewChanged"
                                     ToolTip="Every file scanned, by kind: videos, images, archives, installers and so on" />
                    </StackPanel>
                    <TextBlock x:Name="TopLevelHeader" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </DockPanel>
                <!-- One cell, one of the two views shown, as the choice above says: the folders, or the files by kind. -->
                <Grid>
                    <DockPanel x:Name="FoldersView">
                    <!-- The folder tree's headings, shown with it: the same widths, docked to the same right edge as its
                         rows, less the tree's border, padding and its vertical scroll bar, which is always shown. -->
                    <DockPanel x:Name="FolderTreeHeadings" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,2,2">
                        <Border DockPanel.Dock="Right" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
                        <TextBlock DockPanel.Dock="Right" Width="102" Margin="8,0,0,0" Text="Size" TextAlignment="Right" Foreground="Gray" />
                        <TextBlock DockPanel.Dock="Right" Width="102" Margin="8,0,0,0" Text="On disk" TextAlignment="Right" Foreground="Gray" />
                        <TextBlock DockPanel.Dock="Right" Width="116" Margin="12,0,0,0" Text="Share of folder, on disk" TextTrimming="CharacterEllipsis"
                                   Foreground="Gray" ToolTip="Each row's share of the space its folder takes on disk" />
                        <TextBlock Margin="22,0,0,0" Text="Name" Foreground="Gray" />
                    </DockPanel>
                    <!-- One cell, one of the two shown: the results list while a scan runs and after a stop or a failure
                         (SL-039), the folder tree once a scan completes (SL-044). -->
                    <Grid>
                        <ListBox x:Name="TopLevelList" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,2" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Converter={StaticResource RowTitle}}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Converter={StaticResource RowFigures}}" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- The folder tree (SL-044): a completed scan's store, largest first by space on disk, each row's
                             share of its folder beside it, one folder opened at a time. Virtualized as it was measured
                             (spike tree-layer-fits-under-1gib-with-built-store-at-5m, U-001): in this bounded cell only the
                             rows on screen get containers, recycled, scrolled by pixel, every row the same height. The rows
                             come in Core's order (ChildrenLargestFirst) and nothing here sorts them. Text is TextBlocks
                             bound to the row, never a Label or a ContentPresenter over a string, so '_' and '&' in a name
                             show as written. -->
                        <TreeView x:Name="FolderTree" Visibility="Collapsed"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  TreeViewItem.Expanded="OnFolderExpanded" PreviewKeyDown="OnFolderTreeKeyDown">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Template" Value="{StaticResource FolderTreeItem}" />
                                    <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children, Mode=OneWay}">
                                    <DockPanel Height="20" Background="Transparent">
                                        <!-- 102 wide, not 80 (SL-113, spike 125): 'at least 1,000 bytes', the widest figure a stopped
                                             scan's row can draw, needs 101.3 DIP at this font, and 80 clips it to 'at least 1,000 b'. -->
                                        <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Width="102" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding SizeText, Mode=OneTime}" TextAlignment="Right" Foreground="Gray" />
                                        <TextBlock x:Name="OnDiskText" DockPanel.Dock="Right" Width="102" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding OnDiskText, Mode=OneTime}" TextAlignment="Right" />
                                        <Grid DockPanel.Dock="Right" Width="116" Margin="12,0,0,0">
                                            <Border x:Name="ShareTrack" Width="60" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="#FFE4E4E4" Visibility="{Binding ShareShown, Mode=OneTime}">
                                                <Rectangle x:Name="ShareBar" HorizontalAlignment="Left" Fill="#FF5E9E4A"
                                                           Width="{Binding BarWidth, Mode=OneTime}" />
                                            </Border>
                                            <TextBlock x:Name="ShareText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding ShareText, Mode=OneTime}" TextAlignment="Right" />
                                        </Grid>
                                        <TextBlock x:Name="NoteText" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding Note, Mode=OneTime}" Foreground="Gray" />
                                        <TextBlock x:Name="NameText" VerticalAlignment="Center" Text="{Binding Name, Mode=OneTime}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name, Mode=OneTime}" />
                                    </DockPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                    </DockPanel>

                    <!-- The files by kind (SL-046): at most ten rows, in Core's order, largest on disk first; never a list of
                         files. The caption is one line, trimmed, with the whole of it as its tooltip, so the view keeps a full
                         row in the cell's minimum as the results list does. Which kind a file is, and every figure, is Core's;
                         the rows are only its words (KindRowText). The extensions column gets what the fixed columns leave,
                         trimmed, with the whole of it as its tooltip; the Installers and Programs rows say, when pointed at,
                         that a setup program is counted as a program. -->
                    <DockPanel x:Name="KindsView" Visibility="Collapsed">
                        <TextBlock x:Name="KindsCaption" DockPanel.Dock="Top" Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <Grid x:Name="KindsHeadings" DockPanel.Dock="Top" Visibility="Collapsed" Margin="5,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Kind" Foreground="Gray" />
                            <TextBlock Grid.Column="1" Text="Files" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
                            <TextBlock Grid.Column="2" Text="Size" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
                            <TextBlock Grid.Column="3" Text="On disk" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
                            <TextBlock Grid.Column="4" Text="Share" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray"
                                       ToolTip="Each kind's share of the space all the files take on disk" />
                            <TextBlock Grid.Column="5" Text="Biggest extensions, on disk" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ListBox x:Name="KindsList" Visibility="Collapsed" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding Tip, Mode=OneTime}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Files, Mode=OneTime}" TextAlignment="Right" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Size, Mode=OneTime}" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
                                        <TextBlock Grid.Column="3" Text="{Binding OnDisk, Mode=OneTime}" TextAlignment="Right" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding Share, Mode=OneTime}" TextAlignment="Right" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="5" Text="{Binding Extensions, Mode=OneTime}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Extensions, Mode=OneTime}" Foreground="Gray" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
