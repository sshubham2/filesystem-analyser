<Window x:Class="FsAnalyser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FsAnalyser.App"
        Title="Filesystem Analyser" Width="880" Height="600" MinWidth="560" MinHeight="400"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <local:TopLevelRowText x:Key="RowTitle" />
        <local:TopLevelRowText x:Key="RowFigures" Figures="True" />
    </Window.Resources>
    <DockPanel Margin="16">

        <!-- Pick a drive or folder -->
        <StackPanel x:Name="PickerPanel" DockPanel.Dock="Top">
            <TextBlock Text="Pick a drive or folder to scan" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="DriveStatus" Text="Looking for drives..." Foreground="Gray" Margin="0,0,0,4" />
            <WrapPanel x:Name="DrivePanel" />
            <Button x:Name="ChooseFolderButton" Content="Choose a folder..." HorizontalAlignment="Left"
                    Padding="12,6" Margin="0,8,0,0" Click="OnChooseFolder" />
        </StackPanel>

        <!-- A scan in progress -->
        <Border x:Name="ScanningPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,16,0,0"
                Padding="12" BorderBrush="#FFB0C4DE" BorderThickness="1" Background="#FFF4F8FC">
            <StackPanel>
                <TextBlock x:Name="ScanningTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <!-- Shown only while a cancelled scan has not returned after 2 s (StoppingWait) -->
                <TextBlock x:Name="StoppingDetail" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF7A5200" Visibility="Collapsed" />
                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8" />
                <TextBlock x:Name="CountersText" />
                <TextBlock x:Name="CurrentFolderText" Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Left" Padding="12,4"
                        Margin="0,10,0,0" Click="OnCancel" />
            </StackPanel>
        </Border>

        <!-- How the last scan ended: Finished, Stopped, Could not read or Scan failed -->
        <Border x:Name="OutcomePanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,16,0,0" Padding="12" BorderThickness="1">
            <!-- Below the texts, the largest files and the unreadable folders share what the panel has left (SL-040,
                 O-024). Closed, the unreadable folders are one header line and the largest files take the rest.
                 Opened, the two rows split it 3 to 2 as star rows, so each list is bounded, scrolls inside its own
                 share and stays virtualized, and neither can push the other out of the panel however many
                 folders could not be read. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="Auto" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsExpanded, ElementName=UnreadableExpander}" Value="True" />
                                            <Condition Binding="{Binding Visibility, ElementName=UnreadableExpander}" Value="Visible" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Height" Value="2*" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="OutcomeTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="OutcomeDetail" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock x:Name="OutcomeNotes" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF7A5200" />
                </StackPanel>

                <Expander x:Name="UnreadableExpander" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
                    <ListBox x:Name="UnreadableList" MinHeight="40" MaxHeight="200"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                </Expander>

                <!-- The largest single files under the root (SL-040). Horizontal scrolling is off so that each
                     location wraps to the row's width instead of running off to the right. -->
                <DockPanel x:Name="LargestFilesPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="Largest files, by space on disk" FontWeight="SemiBold" />
                    <TextBlock x:Name="LargestFilesCaption" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,4" />
                    <Grid x:Name="LargestFilesHeadings" DockPanel.Dock="Top" Margin="5,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="On disk" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
                        <TextBlock Grid.Column="1" Text="Size" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
                        <TextBlock Grid.Column="2" Text="Location" Foreground="Gray" />
                    </Grid>
                    <ListBox x:Name="LargestFilesList" MinHeight="40"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OnDiskText, Mode=OneTime}" TextAlignment="Right" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText, Mode=OneTime}" TextAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
                                    <TextBlock Grid.Column="2" Text="{Binding Path, Mode=OneTime}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>

        <!-- What has been read under the root, largest first: filled in while the scan runs and kept after it
             ends (SL-039). The last child, so the list gets the rest of the window's height, which is what
             lets it virtualize: only the rows on screen get containers. Two TextBlocks a row, as measured. -->
        <DockPanel x:Name="TopLevelPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock x:Name="TopLevelHeader" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ListBox x:Name="TopLevelList" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Converter={StaticResource RowTitle}}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Converter={StaticResource RowFigures}}" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

    </DockPanel>
</Window>
