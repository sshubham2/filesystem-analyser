<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FsAnalyser.App</RootNamespace>
    <AssemblyName>FsAnalyser.App</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- The memory budget (U-001, 699 MiB peak at 5M entries) was measured under workstation GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>

    <!-- One self-contained .exe, no installer. Trimming is unsupported for WPF. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsAnalyser.Core\FsAnalyser.Core.csproj" />
  </ItemGroup>

</Project>
