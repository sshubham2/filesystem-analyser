<Project>
  <!-- Shared by every project. Windows only: the scanner is Win32 through and through. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- The SMB rig's server, pinned once (HF-013): tests/FsAnalyser.Core.Tests/Rig/SmbRig.cs is compiled into Core.Tests
       and tests/window/StallRig, and calls a private overload of SMBServer.Start by reflection with an exact parameter
       list, so a version bumped in one project only would compile and then fail at run time in that one. -->
  <PropertyGroup>
    <FsaSmbLibraryVersion>1.5.8.1</FsaSmbLibraryVersion>
    <FsaSmbLibraryWin32Version>1.5.8</FsaSmbLibraryWin32Version>
  </PropertyGroup>
</Project>
